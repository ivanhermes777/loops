# Zelvari premium cellphone buyback local configuration
# Copy to .env or export these values in your shell before running locally.

# Required for /admin login. Do not commit real credentials.
BUYBACK_ADMIN_USERNAME=change-me
BUYBACK_ADMIN_PASSWORD=change-me

# Optional SQLite database path. Defaults to ./buyback.sqlite3.
BUYBACK_DB_PATH=buyback.sqlite3

# Optional runtime port when not passing --port. Defaults to 8000.
PORT=8000

# Demo/manual-only notes:
# - Customer auth screens do not store login credentials.
# - Shipping labels, payments, emails, carrier checks, and external integrations are not connected.
# - Seed data is mock/demo pricing and seeded page content only.
