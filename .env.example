# Zelvari cellphone buyback MVP local configuration
# Copy to .env or export these values in your shell before running locally.

# Required for /admin login. Do not commit real credentials.
BUYBACK_ADMIN_USERNAME=change-me
BUYBACK_ADMIN_PASSWORD=change-me

# Optional SQLite database path. Defaults to ./buyback.sqlite3.
BUYBACK_DB_PATH=buyback.sqlite3

# Optional server-side /prompt-builder command configuration.
# Do not put public-user secrets in the browser. Configure Hermes/OpenAI Codex OAuth
# only on the server environment. The command must be a JSON array, receives JSON
# on stdin with prompt/goal/tone/platform, and should print only the improved prompt.
PROMPT_BUILDER_COMMAND_JSON=["python3","scripts/your_prompt_builder_command.py"]
PROMPT_BUILDER_TIMEOUT_SECONDS=20
